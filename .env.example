# =============================================================================
#  Eirene - Gestion de Citas | Configuracion de DESARROLLO (XAMPP)
#  Copia este archivo como .env y ejecuta: php artisan key:generate
#  Para produccion usa .env.production.example (ver docs/DESPLIEGUE.md)
# =============================================================================

APP_NAME="Eirene"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Lima

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de datos (XAMPP: usuario root sin contrasena) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eirene_citas
DB_USERNAME=root
DB_PASSWORD=
# Carpeta de mysqldump para los respaldos
DB_DUMP_BINARY_PATH="C:/xampp/mysql/bin"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# En desarrollo los correos se envian al instante (sin cola)
QUEUE_CONNECTION=sync
CACHE_STORE=database

# --- Correo: en desarrollo se escriben en storage/logs/laravel.log ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="citas@eirene.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Datos de la clinica y reglas de negocio ---
CLINICA_NOMBRE="Clinica Psicologica Eirene"
CLINICA_TELEFONO=
CLINICA_CORREO=
CITAS_MAX_REPROGRAMACIONES=3
CITAS_DURACION_MINUTOS=50
CITAS_INTERVALO_MINUTOS=60
CITAS_ANTICIPACION_MINUTOS=60
AUDITORIA_DIAS_RETENCION=365

# --- Respaldos (spatie/laravel-backup) ---
BACKUP_DISKS=respaldos
BACKUP_NOTIFICATION_EMAIL=
BACKUP_ARCHIVE_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
