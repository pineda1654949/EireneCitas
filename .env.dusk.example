# Entorno de pruebas E2E con Laravel Dusk (Fase 8). Base de datos propia.
APP_NAME="Eirene"
APP_ENV=dusk.local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010
APP_TIMEZONE=America/Lima
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eirene_dusk
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
LOG_CHANNEL=single
LIMITE_FORMULARIOS_POR_MINUTO=1000
