# =============================================================================
#  Eirene - .env para InfinityFree (hosting gratuito sin terminal ni cron)
#  El empaquetador lo copia como htdocs/eirene/.env y genera APP_KEY.
#  Completa los valores <...> con los datos del panel de InfinityFree
#  (MySQL Databases). NUNCA subas este archivo con valores reales a Git.
# =============================================================================

APP_NAME="Eirene"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<tu-subdominio>
APP_TIMEZONE=America/Lima

APP_LOCALE=es
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Datos del panel: MySQL Databases (el host es del tipo sqlXXX.infinityfree.com)
DB_CONNECTION=mysql
DB_HOST=<sqlXXX.infinityfree.com>
DB_PORT=3306
DB_DATABASE=<if0_XXXXXXXX_eirene>
DB_USERNAME=<if0_XXXXXXXX>
DB_PASSWORD=<contrasena_de_la_cuenta_de_hosting>

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database

# Sin cron no hay quien procese una cola: los correos se envian al momento.
QUEUE_CONNECTION=sync

# "log" deja los correos en storage/logs. Para enviarlos de verdad, usa un
# SMTP externo (p. ej. Gmail con contrasena de aplicacion):
#   MAIL_MAILER=smtp  MAIL_SCHEME=smtps  MAIL_HOST=smtp.gmail.com  MAIL_PORT=465
MAIL_MAILER=log
MAIL_FROM_ADDRESS="citas@eirene.test"
MAIL_FROM_NAME="${APP_NAME}"

CLINICA_NOMBRE="Clinica Psicologica Eirene"
CLINICA_TELEFONO=
CLINICA_CORREO=
CITAS_MAX_REPROGRAMACIONES=3
CITAS_DURACION_MINUTOS=50
CITAS_INTERVALO_MINUTOS=60
CITAS_ANTICIPACION_MINUTOS=120
AUDITORIA_DIAS_RETENCION=365

# Sin cron ni mysqldump en el hosting: los respaldos se hacen desde phpMyAdmin.
BACKUP_DISKS=respaldos
BACKUP_NOTIFICATION_EMAIL=
BACKUP_ARCHIVE_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
