# =============================================================================
#  Eirene - Gestion de Citas | Plantilla de PRODUCCION
#  1. Copiala en el servidor como .env (NUNCA la subas a Git con valores reales)
#  2. Completa los valores marcados con <...>
#  3. Genera la clave UNA sola vez: php artisan key:generate
#     (si la cambias, las notas clinicas cifradas ya no podran leerse)
# =============================================================================

APP_NAME="Eirene"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<tu-dominio>
APP_TIMEZONE=America/Lima

APP_LOCALE=es
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logs diarios, se conservan 14 dias
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<base_de_datos>
DB_USERNAME=<usuario_con_permisos_minimos>
DB_PASSWORD=<contrasena_segura>
DB_DUMP_BINARY_PATH=

# Sesiones cifradas, solo por HTTPS
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# Solo si el hosting usa proxy/balanceador (p. ej. Cloudflare): TRUSTED_PROXIES=*
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Los correos se encolan; el cron (schedule:run) procesa la cola cada minuto
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=<smtp.proveedor.com>
MAIL_PORT=465
MAIL_USERNAME=<usuario_smtp>
MAIL_PASSWORD=<contrasena_smtp>
MAIL_FROM_ADDRESS="<citas@tu-dominio>"
MAIL_FROM_NAME="${APP_NAME}"

CLINICA_NOMBRE="Clinica Psicologica Eirene"
CLINICA_TELEFONO=
CLINICA_CORREO=
CITAS_MAX_REPROGRAMACIONES=3
CITAS_DURACION_MINUTOS=50
CITAS_INTERVALO_MINUTOS=60
CITAS_ANTICIPACION_MINUTOS=120
AUDITORIA_DIAS_RETENCION=365

BACKUP_DISKS=respaldos
BACKUP_NOTIFICATION_EMAIL=<correo_del_responsable>
BACKUP_ARCHIVE_PASSWORD=<contrasena_para_cifrar_los_respaldos>

VITE_APP_NAME="${APP_NAME}"
